# Server & Port Configuration
PORT=3001
NODE_ENV=development

# Authentication & Session Secret
SESSION_SECRET=sanctuary_institute_jwt_secret_change_in_production

# URL to the Public Landing Page (when deployed across separate repositories / domains)
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Database Connection
# Connection Pooler (Port 6543):
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Direct Database URL (Port 5432):
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
